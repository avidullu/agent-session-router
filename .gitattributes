# The Agent Sessions archive format is LF-only (the hub writes newline="\n").
# Keep the vendored output-contract golden fixtures byte-exact LF on every
# platform so the conformance tests pass identically on Windows and Linux.
test/fixtures/contract/** text eol=lf

# Prettier is configured with endOfLine=lf; keep TypeScript sources LF on
# every platform so `npm run format:check` gives the same verdict on Windows
# checkouts (core.autocrlf=true materializes CRLF otherwise) as on Linux CI.
src/**/*.ts text eol=lf
